SSO_ENABLED=true
SSO_AUTHORITY=https://family-login.example.invalid/realms/tvceb-family
SSO_CLIENT_ID=vaultwarden
SSO_CLIENT_SECRET=REPLACE_PRIVATELY_FROM_GENERATED_CLIENT_SETTINGS
SSO_PKCE=true
SSO_ONLY=false
SSO_SIGNUPS_MATCH_EMAIL=false
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false
SIGNUPS_ALLOWED=false
# Existing users link SSO while signed in to their existing vault.
# SSO authenticates the account; their vault master password still unlocks it.
