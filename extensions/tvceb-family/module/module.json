{
  "manifestVersion": 1,
  "id": "tvceb-family",
  "name": "Family home",
  "version": "2.0.0",
  "description": "Simple family activities, knowledgebase, messages and private service links.",
  "entry": "index.js",
  "icon": "house",
  "accent": "#A71D32",
  "menu": {
    "show": true,
    "label": "Family home",
    "icon": "house",
    "order": 10
  },
  "page": {
    "composition": "dashboard",
    "width": "wide",
    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "Family home",
        "icon": "house"
      }
    },
    "api": {
      "prefix": "/api/extensions/tvceb-family"
    }
  },
  "settings": {
    "entry": "settings.js",
    "sections": [
      "household"
    ]
  }
}
