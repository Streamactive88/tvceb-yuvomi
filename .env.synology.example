# Copy to .env beside compose.synology.yaml before creating the DSM project.
# Generate a new session secret: openssl rand -hex 48
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
SESSION_SECURE=false
TRUST_PROXY=0
# Existing encrypted database: use its EXACT existing key.
# Leave empty to match the supplied stack's unencrypted database.
DB_ENCRYPTION_KEY=
# Optional private recovery-file path, shared by the helper and server.
# ADMIN_RECOVERY_FILE=/backups/admin-recovery.json
